{
  "manifest_version": 3,
  "name": "Memact",
  "version": "0.0.0",
  "version_name": "v0.0",
  "description": "Optional local capture for Memact.",
  "icons": {
    "16": "icons/memact_16.png",
    "32": "icons/memact_32.png",
    "48": "icons/memact_48.png",
    "128": "icons/memact_128.png"
  },
  "permissions": ["tabs", "windows", "scripting", "storage", "unlimitedStorage", "webNavigation", "history", "alarms"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://0.0.0.0/*",
    "https://0.0.0.0/*",
    "https://memact.com/*",
    "https://www.memact.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none';"
  },
  "action": {
    "default_title": "Memact Extension",
    "default_icon": {
      "16": "icons/memact_16.png",
      "32": "icons/memact_32.png",
      "48": "icons/memact_48.png",
      "128": "icons/memact_128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-api.js"],
      "matches": [
        "https://memact.com/*",
        "https://www.memact.com/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://0.0.0.0/*",
        "https://0.0.0.0/*"
      ]
    }
  ]
}
